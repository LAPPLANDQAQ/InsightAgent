# Experimental / archived flags not enabled in the stable runtime.

# RAG preview knobs. Stable local demo keeps ENABLE_RAG_RESEARCH=false.
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_SPARSE_TOP_K=8
RAG_DENSE_TOP_K=8
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
EMBEDDING_PROVIDER=fake

# Harness preview. Not enabled in the stable runtime by default.
ENABLE_HARNESS=false
HARNESS_TRACE_PAYLOAD_LIMIT=1000
HARNESS_MAX_TOOL_CALLS_PER_TASK=50
HARNESS_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# MCP preview. Not enabled in the stable runtime by default.
ENABLE_MCP_SERVER=false
MCP_TRANSPORT=stdio
MCP_HTTP_AUTH_TOKEN=
MCP_ALLOW_WRITE_TOOLS=false
MCP_ALLOW_LOCALHOST=false

# Optional retrieval experiments.
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITE=false
ENABLE_HYDE=false
ENABLE_CRAG=false

# Experimental cost guards.
MAX_HEAVY_CALLS_PER_TASK=8
MAX_HEAVY_TOKENS_PER_TASK=35000
MAX_LIGHT_TOKENS_PER_TASK=100000
