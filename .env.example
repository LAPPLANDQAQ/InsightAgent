# Runtime
APP_ENV=dev
LOG_LEVEL=INFO

# LLM Provider
# DeepSeek uses an OpenAI-compatible API.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_key_here
LLM_HEAVY_MODEL=deepseek-v4-pro
LLM_LIGHT_MODEL=deepseek-v4-flash
LLM_FALLBACK_MODEL=deepseek-v4-flash
ENFORCE_PROVIDER_MODEL_GUARD=true

# Search
# Empty Tavily API key means Tavily will be skipped and DuckDuckGo can be used.
SEARCH_PROVIDERS=tavily,duckduckgo
TAVILY_API_KEY=
SEARCH_PROVIDER_TIMEOUT_SECONDS=10.0

# Cache / DB
CACHE_BACKEND=sqlite
DB_URL=sqlite:///./data/insight.db
# MYSQL_URL is reserved for optional MySQL experiments.
# The stable default runtime uses SQLite.
MYSQL_URL=

# Concurrency
MAX_CONCURRENT_SEARCH=5
MAX_CONCURRENT_FETCH=8
MAX_CONCURRENT_LLM_HEAVY=2
MAX_CONCURRENT_LLM_LIGHT=5
MAX_CONCURRENT_TASKS=2
MAX_QUEUED_TASKS=20
TASK_TIMEOUT_SECONDS=900

# Workflow
MAX_ITERATIONS=3
MAX_SEARCH_ROUNDS_PER_COMPETITOR=3
SUFFICIENCY_THRESHOLD=0.6
ENABLE_LLM_CRITIC=false

# v4 RAG workflow
ENABLE_RAG_RESEARCH=false
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_SPARSE_TOP_K=8
RAG_DENSE_TOP_K=8
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
EMBEDDING_PROVIDER=fake

# v4 Harness
ENABLE_HARNESS=true
HARNESS_TRACE_PAYLOAD_LIMIT=1000
HARNESS_MAX_TOOL_CALLS_PER_TASK=50
HARNESS_REQUIRE_APPROVAL_FOR_HIGH_RISK=true

# v4 MCP
ENABLE_MCP_SERVER=true
MCP_TRANSPORT=stdio
MCP_HTTP_AUTH_TOKEN=
MCP_ALLOW_WRITE_TOOLS=false
MCP_ALLOW_LOCALHOST=false

# Optional retrieval enhancements are disabled by default for deterministic local runs.
ENABLE_RERANKER=false
ENABLE_QUERY_REWRITE=false
ENABLE_HYDE=false
ENABLE_CRAG=false

# Cost guard
MAX_HEAVY_CALLS_PER_TASK=8
MAX_HEAVY_TOKENS_PER_TASK=35000
MAX_LIGHT_TOKENS_PER_TASK=100000
